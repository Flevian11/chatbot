# OpenRouter key: create it in your OpenRouter dashboard. Never expose it to JS.
OPENROUTER_API_KEY=paste_your_openrouter_key_here

# Ordered model failover chain. OpenRouter tries the next model if the prior
# model/provider fails. This is sequential failover, not parallel fan-out.
# These model IDs were checked against the OpenRouter catalogue when this
# classroom package was prepared; re-check availability/pricing before launch.
OPENROUTER_MODELS=google/gemini-3-flash-preview,moonshotai/kimi-k2.5,meta/muse-ember

APP_NAME=LWF Class Chatbot
APP_URL=https://lwf.yaliid.cloud/class-chatbot
DEFAULT_MODE=lms

MAX_INPUT_CHARS=6000
MAX_OUTPUT_TOKENS=1800
MODEL_TEMPERATURE=0.35
RATE_LIMIT_PER_HOUR=45

# Local knowledge retrieval and conversation context
RETRIEVAL_LIMIT_LMS=8
RETRIEVAL_LIMIT_GENERAL=5
MAX_KNOWLEDGE_CHARS=18000
CHAT_HISTORY_MESSAGES=80
MAX_ATTACHMENT_CONTEXT_CHARS=60000
